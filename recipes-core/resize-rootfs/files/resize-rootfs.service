[Unit]
Description=Resize root partition and filesystem to fill disk
DefaultDependencies=no
After=local-fs.target
Before=systemd-update-utmp.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/resize-rootfs.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
