From: AMD EDF <amd-edf@local>
Date: Tue, 17 Mar 2026 13:00:00 +0000
Subject: [PATCH] udev: do not silence initramfs console on console open failure
Upstream-Status: Pending

Avoid redirecting initramfs stdio to /dev/null when /dev/console open
fails in udev_run. Keep output visible and fall back to /dev/tty0.

--- udev
+++ udev
@@ -42,7 +42,12 @@
 	mkdir -p /var/run
 
 	# Workaround if console=null, systemd-udevd needs valid stdin, stdout and stderr to work
-	sh -c "exec 4< /dev/console" || { exec 0> /dev/null; exec 1> /dev/null; exec 2> /dev/null; }
+	if ! sh -c "exec 4< /dev/console"; then
+                msg "WARNING: /dev/console open failed in udev_run; falling back to tty0"
+                if [ -c /dev/tty0 ]; then
+                        exec </dev/tty0 >/dev/tty0 2>&1
+                fi
+        fi
 
 	$_UDEV_DAEMON --daemon
 	udevadm trigger --action=add
-- 
2.34.1
